# Local development. Every variable is optional except DATABASE_URL.
DATABASE_URL=postgresql://refunds:refunds@localhost:55432/refunds_nest
PORT=3001
LLM_PROVIDER=mock
LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
# Demo mode enables POST /admin/demo/reset and tolerates the well-known admin token. The app
# default is false; with NODE_ENV=production and DEMO_MODE=false, ADMIN_TOKEN must be a secret of
# at least 32 characters or the app refuses to start.
DEMO_MODE=true
ADMIN_TOKEN=demo-admin
CORS_ORIGIN=http://localhost:8080
# Comma-separated IPs/CIDRs whose X-Forwarded-For is honoured. Empty trusts no proxy.
TRUSTED_PROXIES=
RATE_LIMIT_VERIFY_PER_MINUTE=60
RATE_LIMIT_MESSAGES_PER_MINUTE=60
RATE_LIMIT_ADMIN_FAILURES_PER_MINUTE=20
MAX_CONVERSATIONS_PER_ORDER_PER_DAY=20
LLM_MAX_CALLS_PER_HOUR=1000
