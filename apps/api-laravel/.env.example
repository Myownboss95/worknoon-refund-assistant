APP_NAME="Worknoon Refund Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3002

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=refunds_laravel
DB_USERNAME=refunds
DB_PASSWORD=refunds

CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Refund assistant
LLM_PROVIDER=mock
LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
# DEMO_MODE=true enables POST /admin/demo/reset and tolerates the demo token. With DEMO_MODE=false and
# APP_ENV=production the app refuses to boot unless ADMIN_TOKEN is at least 32 characters and not demo-admin.
DEMO_MODE=true
ADMIN_TOKEN=demo-admin
# Comma-separated IPs/CIDRs whose X-Forwarded-For is honoured; empty trusts none.
TRUSTED_PROXIES=
CORS_ORIGIN=http://localhost:8080
RATE_LIMIT_VERIFY_PER_MINUTE=60
RATE_LIMIT_MESSAGES_PER_MINUTE=60
RATE_LIMIT_ADMIN_FAILURES_PER_MINUTE=20
MAX_CONVERSATIONS_PER_ORDER_PER_DAY=20
LLM_MAX_CALLS_PER_HOUR=1000
# CONTRACTS_PATH=/absolute/path/to/contracts
# POLICY_DOC_PATH=/absolute/path/to/policy/refund-policy.md
