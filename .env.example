# Everything is optional. `docker compose up --build` works with no .env at all (mock AI, demo mode).

# mock | anthropic. anthropic needs ANTHROPIC_API_KEY; without a key the backends fall back to mock.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
# Global budget of real model calls per hour; past it, requests fail safe to escalation.
LLM_MAX_CALLS_PER_HOUR=1000

# Demo mode enables the reset endpoint and allows the well-known admin token below.
# For anything other than a local demo: DEMO_MODE=false and a random ADMIN_TOKEN of 32+ characters.
DEMO_MODE=true
ADMIN_TOKEN=demo-admin

# Requests per minute per client IP.
RATE_LIMIT_VERIFY_PER_MINUTE=60
RATE_LIMIT_MESSAGES_PER_MINUTE=60
RATE_LIMIT_ADMIN_FAILURES_PER_MINUTE=20
MAX_CONVERSATIONS_PER_ORDER_PER_DAY=20

# Postgres passwords, applied when the data volume is first created.
POSTGRES_PASSWORD=refunds
APP_DB_PASSWORD=refunds_app

# Host port for Postgres (bound to 127.0.0.1, for local development and tests).
DB_HOST_PORT=55432
