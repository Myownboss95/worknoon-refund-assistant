# Everything is optional. `docker compose up --build` works with no .env at all (mock AI mode).

# mock | anthropic. anthropic needs ANTHROPIC_API_KEY; without a key the backends fall back to mock.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Token for the admin dashboard (sent as the X-Admin-Token header).
ADMIN_TOKEN=demo-admin

# Requests per minute per IP. The apps default to 60; compose raises it so the contract suite can be rerun back to back.
RATE_LIMIT_VERIFY_PER_MINUTE=300
RATE_LIMIT_MESSAGES_PER_MINUTE=300

# Host port for Postgres (published for local development and tests).
DB_HOST_PORT=55432
